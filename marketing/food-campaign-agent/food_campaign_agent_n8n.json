    },
    {
      "parameters": {
        "model": "gpt-4o",
        "options": {
          "temperature": 0.7,
          "maxTokens": 2000
        },
        "messages": {
          "message": [
            {
              "role": "system",
              "content": "أنت \"ذوق\" - وكيل استراتيجي متخصص في الحملات الإعلانية للمواد الغذائية.\n\n# القيود الصارمة:\n- لا تذكر أي مطالبات صحية غير مثبتة\n- تجنب كلمات: \"رخيص\"، \"قديم\"، \"مصنع\"، \"تقليد\"\n- ركز على: \"طازج\"، \"ممتاز\"، \"عائلي\"، \"أصيل\"، \"موثوق\"\n- كل المحتوى باللغة العربية\n- أخرج JSON صالح فقط بدون أي نص إضافي"
            },
            {
              "role": "user",
              "content": "صمم استراتيجية حملة إعلانية متكاملة:\n\nاسم الحملة: {{ $json.data.campaign_name }}\nفئة المنتج: {{ $json.data.product_category }}\nالجمهور المستهدف: {{ $json.data.target_audience }}\nالميزانية: {{ $json.data.budget_range }}\nالمدة: {{ $json.data.duration_days }} يوم\nالمنصات: {{ $json.data.platforms.join(', ') }}\nالمناسبة: {{ $json.data.seasonal_event }}\nطلبات خاصة: {{ $json.data.special_requests }}\n\nBrand DNA: {{ $json.brand_dna }}\n\nالمطلوب:\n1. الزاوية الإبداعية\n2. نبرة الصوت\n3. الرسالة الرئيسية\n4. لوحة الألوان\n5. خطة المحتوى (نوع + عدد + منصة)\n6. توزيع الميزانية\n7. استراتيجية الهاشتاقات\n\nأخرج JSON صالح فقط:"
            }
          ]
        }
      },
      "id": "ai-strategist-005",
      "name": "AI Campaign Strategist",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1.6,
      "position": [
        850,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const strategyText = $input.first().json.message?.content || $input.first().json.content || '';\nlet strategy;\n\ntry {\n  // استخراج JSON من النص\n  const jsonMatch = strategyText.match(/```json\\s*([\\s\\S]*?)```/) || \n                    strategyText.match(/{[\\s\\S]*}/);\n\n  if (jsonMatch) {\n    strategy = JSON.parse(jsonMatch[1] || jsonMatch[0]);\n  } else {\n    strategy = JSON.parse(strategyText);\n  }\n} catch (e) {\n  strategy = {\n    error: true,\n    raw_response: strategyText,\n    parse_error: e.message\n  };\n}\n\nreturn [{\n  json: {\n    ...$input.first().json,\n    strategy: strategy,\n    strategy_valid: !strategy.error\n  }\n}];"
      },
      "id": "parse-strategy-006",
      "name": "Parse Strategy JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
