      "id": "webhook-trigger-001",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [
        250,
        300
      ],
      "webhookId": "food-campaign-agent"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json.body || $input.first().json;\n\nconst required = ['campaign_name', 'product_category', 'target_audience', 'platforms'];\nconst missing = required.filter(field => !input[field]);\n\nif (missing.length > 0) {\n  return [{\n    json: {\n      status: \"error\",\n      message: `الحقول المفقودة: ${missing.join(', ')}`,\n      code: \"MISSING_FIELDS\",\n      input_data: input\n    }\n  }];\n}\n\nconst supportedPlatforms = ['instagram', 'facebook', 'tiktok', 'snapchat', 'youtube'];\nconst invalidPlatforms = input.platforms.filter(p => !supportedPlatforms.includes(p.toLowerCase()));\n\nif (invalidPlatforms.length > 0) {\n  return [{\n    json: {\n      status: \"error\", \n      message: `منصات غير مدعومة: ${invalidPlatforms.join(', ')}`,\n      code: \"INVALID_PLATFORMS\",\n      input_data: input\n    }\n  }];\n}\n\nconst normalized = {\n  ...input,\n  platforms: input.platforms.map(p => p.toLowerCase()),\n  content_types: input.content_types || ['images'],\n  duration_days: input.duration_days || 30,\n  seasonal_event: input.seasonal_event || 'general',\n  budget_range: input.budget_range || 'غير محدد',\n  special_requests: input.special_requests || '',\n  brand_id: input.brand_id || 'default'\n};\n\nreturn [{\n  json: {\n    status: \"success\",\n    data: normalized,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "validate-input-002",
      "name": "Validate Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        450,
        300
      ]
    },
    {
