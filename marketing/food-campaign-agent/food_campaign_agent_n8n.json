      "parameters": {
        "values": {
          "string": [
            {
              "name": "brand_dna",
              "value": "{\n  \"brand_voice\": {\n    \"personality\": [\"طازج\", \"موثوق\", \"عائلي\", \"أصيل\"],\n    \"forbidden_words\": [\"رخيص\", \"قديم\", \"مصنع\", \"تقليد\"],\n    \"signature_phrases\": [\"من المزرعة إلى مائدتك\", \"جودة تستحق الثقة\"]\n  },\n  \"visual_identity\": {\n    \"primary_colors\": [\"#2E7D32\", \"#FF6F00\", \"#F5F5DC\"],\n    \"typography\": \"Noto Kufi Arabic\",\n    \"photography_style\": \"natural_lighting, shallow_depth, warm_tones, rustic_wood_background\"\n  },\n  \"product_catalog\": {\n    \"categories\": [\"خضروات\", \"فواكه\", \"لحوم\", \"معلبات\", \"تمور\"],\n    \"hero_products\": [\"التمر الممتاز\", \"الزيتون البكر\", \"العسل الطبيعي\"]\n  },\n  \"compliance_rules\": {\n    \"health_claims\": false,\n    \"halal_certification\": true,\n    \"organic_claims\": \"requires_certificate\"\n  }\n}"
            }
          ]
        },
        "options": {}
      },
      "id": "brand-dna-004",
      "name": "Load Brand DNA",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        650,
