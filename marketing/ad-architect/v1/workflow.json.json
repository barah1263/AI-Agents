    {
      "parameters": {
        "promptType": "define",
        "text": "=Create an advertising campaign based on this brief (JSON):\n\n{{ JSON.stringify($json.body) }}\n\nFor EACH platform listed in the brief's \"platforms\" array, produce 2 distinct ad variations. Respect platform character norms, apply the brand_voice, and use the given cta. Also write one concise overall strategy summary.",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are \"Ad Architect\", an elite advertising copywriter and strategist. You write high-converting, platform-appropriate ad copy. Hooks grab attention in the first 3 words, body copy focuses on benefits, and every ad has one clear CTA. Always return valid structured output."
        }
      },
