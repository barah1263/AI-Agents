      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\"type\":\"object\",\"properties\":{\"strategy\":{\"type\":\"string\",\"description\":\"Concise campaign strategy summary covering audience insight, positioning and messaging angle\"},\"ads\":{\"type\":\"array\",\"description\":\"One or more ad variations per requested platform\",\"items\":{\"type\":\"object\",\"properties\":{\"platform\":{\"type\":\"string\",\"description\":\"meta | google | tiktok | linkedin | twitter\"},\"headline\":{\"type\":\"string\"},\"body\":{\"type\":\"string\"},\"cta\":{\"type\":\"string\"},\"image_prompt\":{\"type\":\"string\",\"description\":\"Prompt for generating an ad image\"},\"predicted_score\":{\"type\":\"number\",\"description\":\"Predicted performance score 1-10\"}},\"required\":[\"platform\",\"headline\",\"body\",\"cta\"]}}},\"required\":[\"strategy\",\"ads\"]}"
      },
      "id": "08dfa0b4-d1b6-4a0d-bdf0-bde16d8d9a49",
      "name": "Campaign Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        368,
        336
      ]
    },
    {
      "parameters": {
        "jsCode": "const agent = $input.first().json.output || {};\nconst brief = $('Campaign Webhook').first().json.body || {};\nconst strategy = agent.strategy || '';\nconst ads = Array.isArray(agent.ads) ? agent.ads : [];\nconst generatedAt = new Date().toISOString();\nconst rows = ads.map((ad) => ({\n  campaign_name: brief.campaign_name || '',\n  product_service: brief.product_service || '',\n  objective: brief.campaign_objective || '',\n  platform: ad.platform || '',\n  headline: ad.headline || '',\n  body: ad.body || '',\n  cta: ad.cta || brief.cta || '',\n  image_prompt: ad.image_prompt || '',\n  predicted_score: ad.predicted_score != null ? ad.predicted_score : '',\n  landing_page: brief.landing_page || '',\n  strategy: strategy,\n  generated_at: generatedAt,\n}));\nreturn rows.length ? rows.map((json) => ({ json })) : [{ json: { campaign_name: brief.campaign_name || '', strategy, generated_at: generatedAt } }];"
      },
